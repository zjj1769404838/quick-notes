{
  "name": "quick-notes",
  "version": "0.1.0",
  "description": "随手笔记 - 桌面悬浮球 Markdown 速记工具",
  "main": "./out/main/index.cjs",
  "author": "local",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:lite": "npm run build && cross-env QN_EDITION=lite electron-builder --win --config electron-builder.yml",
    "dist:full": "npm run build && cross-env QN_EDITION=full electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "chokidar": "4.0.3",
    "js-yaml": "5.5.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "minisearch": "7.2.0",
    "node-llama-cpp": "3.22.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/markdown": "1.8.1",
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "codemirror": "6.0.2",
    "cross-env": "10.1.0",
    "dompurify": "3.4.18",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
